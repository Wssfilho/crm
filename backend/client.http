@baseurl = http://localhost:3333
@authToken = {{authenticate.response.body.access_token}}

###
# @name createAccount
POST {{baseurl}}/accounts
Content-Type: application/json

{
  "name": "Eric Melo",
  "email": "eric@advocacia.com.br",
  "password": "senha123"
}

###
# @name authenticate
POST {{baseurl}}/sessions
Content-Type: application/json

{
  "email": "eric@advocacia.com.br",
  "password": "senha123"
}

###
# @name getProfile
GET {{baseurl}}/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

###
# @name moverColuna
PATCH {{baseurl}}/clientes/ID_DO_CLIENTE/coluna
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "coluna": "DOCS"
}


###
# @name moverEtapa
PATCH {{baseurl}}/clientes/ID_DO_CLIENTE/etapa
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "etapa": "PROTOCOLO"
}

###
# @name editarCliente
PATCH {{baseurl}}/clientes/ID_DO_CLIENTE
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "driveUrl": "https://drive.google.com/drive/folders/ID_DA_PASTA",
  "observacao": "Falta RG",
  "responsavelId": null
}

###
# @name fetchUsuarios
GET {{baseurl}}/usuarios
Authorization: Bearer {{authToken}}
